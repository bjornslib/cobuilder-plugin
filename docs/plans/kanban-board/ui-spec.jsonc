  "colors": {
    "note": "Every class names a token from plugins/artifact/viewer/src/index.css. The tokens switch on data-theme, so no dark: utility is needed and none is used.",
    "band": { "usage": "The one heading band of the page", "token": "bg-band text-band-ink", "extracted": "#006572 on #ffffff" },
    "surface": { "usage": "Cards, column heads, the command row", "token": "bg-surface", "extracted": "#ffffff" },
    "surface2": { "usage": "Column bodies, control hover", "token": "bg-surface-2", "extracted": "#f4fafb" },
    "surface3": { "usage": "Pressed controls, the progress bar track", "token": "bg-surface-3", "extracted": "#dfecee" },
    "ground": { "usage": "The page ground", "token": "bg-ground", "extracted": "#e9f2f3" },
    "line": { "usage": "Borders and dividers", "token": "border-line", "extracted": "#cfe0e2" },
    "lineSoft": { "usage": "Card borders inside a column", "token": "border-line-soft", "extracted": "#e4eff1" },
    "ink": { "usage": "Primary text", "token": "text-ink", "extracted": "#121d1c" },
    "inkMid": { "usage": "Secondary text, idle controls", "token": "text-ink-mid", "extracted": "#3c4b4a" },
    "inkDim": { "usage": "Labels, counts, empty sentences", "token": "text-ink-dim", "extracted": "#6a7978" },
    "inkFaint": { "usage": "Placeholders, the copy icon, a planned pip", "token": "text-ink-faint", "extracted": "#93a1a0" },
    "accent": { "usage": "Selected switch, hover wash, the current page link", "token": "bg-accent-wash text-accent-deep", "extracted": "#dcedf0 on #125460" },
    "primary": { "usage": "Focus ring, card hover border, the build stage badge", "token": "border-primary text-accent-deep outline-ring", "extracted": "#1d7f8e" },
    "tint": { "usage": "The review stage badge, the pull request badge", "token": "bg-tint text-tint-ink", "extracted": "#cde7ed on #10353b" },
    "good": { "usage": "Done status, the done pip, the Slices done mark, the success notice", "token": "bg-good-wash text-good border-good/40", "extracted": "#2f6b42 on #dfeee4" },
    "warn": { "usage": "In progress status, the decision stage badge, the unknown program notice", "token": "bg-warn-wash text-warn border-warn", "extracted": "#9e5c17 on #f6ead9" },
    "danger": {
      "usage": "The Copy failed notice only",
      "token": "bg-danger-wash text-destructive border-destructive",
      "extracted": "#9c3333 on #f7e3e3",
      "note": "--color-danger is not registered in @theme inline, so the class is text-destructive. A text-danger class would generate no CSS and fail silently."
    },
    "overlay": { "usage": "The Work drawer's own overlay", "token": "bg-ink/55" }
  },

  "typography": {
    "headings": {
      "h1": "font-mono text-[13px] font-bold tracking-[0.02em] uppercase",
      "h2": "m-0 truncate font-serif text-[15px] leading-tight",
      "columnHeading": "sr-only font-mono text-[11px] uppercase"
    },
    "body": {
      "default": "font-mono text-[12.5px] text-ink",
      "cardTitle": "font-mono text-[12px] font-semibold text-ink",
      "prose": "font-serif text-[12px] leading-[1.4] text-ink-mid",
      "emptySentence": "font-serif text-[12.5px] italic text-ink-dim"
    },
    "special": {
      "count": "font-mono text-[13px] font-semibold tabular-nums",
      "columnCount": "font-mono text-[12px] font-bold tabular-nums",
      "label": "font-mono text-[10px] tracking-[0.12em] uppercase",
      "badge": "font-mono text-[10px] uppercase tracking-[0.06em]",
      "meta": "font-mono text-[10.5px] tabular-nums text-ink-dim"
    }
  },

  "interactions": {
    "stateClasses": {
      "default": "bg-surface text-ink",
      "hover": "hover:bg-surface-2 hover:text-foreground",
      "hoverInBand": "hover:underline",
      "focusVisible": "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
      "pressed": "active:bg-surface-3",
      "pressedInBand": "active:bg-band-ink/15",
      "selected": "bg-accent-wash text-accent-deep",
      "selectedTint": "bg-surface-2",
      "disabled": "disabled:pointer-events-none disabled:opacity-45",
      "loading": "opacity-70 pointer-events-none",
      "error": "border-destructive bg-danger-wash text-destructive",
      "empty": "text-ink-dim",
      "transient": "bg-good-wash text-good",
      "cardHover": "hover:border-primary hover:bg-surface-2",
      "native": "appearance-auto, the platform draw only, no house class"
    },

    "transitions": [
      { "trigger": "the index resolves", "from": "loading", "to": "default", "durationToken": "--motion-notice", "easing": "ease-house", "guard": null, "reset": "reduced motion sets 0" },
      { "trigger": "Hide is pressed on a column, with another column visible", "from": "default", "to": "hidden", "durationToken": "--motion-panel", "easing": "ease-house", "guard": "the last visible column's Hide is disabled", "reset": "the rail is pressed" },
      { "trigger": "a rail is pressed", "from": "hidden", "to": "default", "durationToken": "--motion-panel", "easing": "ease-house", "guard": null, "reset": "Hide is pressed again" },
      { "trigger": "the pips toggle is pressed", "from": "collapsed", "to": "expanded", "durationToken": "--motion-panel", "easing": "ease-house", "guard": "the epic holds at least one slice", "reset": "a board change collapses every list" },
      { "trigger": "the pips toggle is pressed again", "from": "expanded", "to": "collapsed", "durationToken": "--motion-panel", "easing": "ease-house", "guard": null, "reset": null },
      { "trigger": "an orphan slice card is pressed", "from": "collapsed", "to": "expanded", "durationToken": "--motion-panel", "easing": "ease-house", "guard": "one card is open at a time", "reset": "another card's press, or a search change" },
      { "trigger": "the open orphan slice card is pressed", "from": "expanded", "to": "collapsed", "durationToken": "--motion-panel", "easing": "ease-house", "guard": null, "reset": null },
      { "trigger": "a program card, the back link, or the No program card is pressed", "from": "programs", "to": "epics", "durationToken": null, "easing": null, "guard": "the target board resolves", "reset": "the board region scrolls to 0 and focus moves to the subject heading" },
      { "trigger": "the address changes to another board", "from": "any board", "to": "the board the address names", "durationToken": null, "easing": null, "guard": "an unknown program shows the program board and a notice", "reset": "scroll positions go to 0" },
      { "trigger": "a clipboard write resolves", "from": "absent", "to": "transient", "durationToken": "--motion-notice", "easing": "ease-house", "guard": null, "reset": "after --hold-ack" },
      { "trigger": "a clipboard write rejects, or the clipboard API is absent", "from": "absent", "to": "error", "durationToken": "--motion-notice", "easing": "ease-house", "guard": null, "reset": "Close or Escape" },
      { "trigger": "Close or Escape on a notice", "from": "transient or error", "to": "absent", "durationToken": "--motion-notice", "easing": "ease-house", "guard": null, "reset": null },
      { "trigger": "a key is typed in Find", "from": "any search", "to": "the search holds the text", "durationToken": null, "easing": null, "guard": null, "reset": "the address is replaced, never pushed" },
      { "trigger": "the pointer enters a control", "from": "default", "to": "hover", "durationToken": "--motion-hover", "easing": "ease-house", "guard": null, "reset": "the pointer leaves" },
      { "trigger": "a control takes keyboard focus", "from": "default", "to": "focus-visible", "durationToken": null, "easing": null, "guard": null, "reset": "focus leaves. The ring is drawn at once and never fades" }
    ],

    "visibility": [
      { "control": "OrderSelect", "rendersWhen": "the board is the program board", "removedWhen": "any other board" },
      { "control": "CardsSwitch", "rendersWhen": "the board is the epic board", "removedWhen": "any other board" },
      { "control": "HideButton", "rendersWhen": "its column is visible", "removedWhen": "its column is hidden" },
      { "control": "HideButton.disabled", "rendersWhen": "it is the last visible column's Hide", "removedWhen": "another column is visible again" },
      { "control": "HiddenColumnRail", "rendersWhen": "its column is hidden", "removedWhen": "its column is visible" },
      { "control": "CopyPromptButton", "rendersWhen": "the record has a next workflow, per the prompt table of contracts.md", "removedWhen": "a program is implemented or superseded, an epic's lifecycle is closed, or the card is a slice" },
      { "control": "SlicesDoneMark", "rendersWhen": "the epic's lifecycle is open and every slice is done", "removedWhen": "any slice is not done, or the lifecycle is closed" },
      { "control": "SlicePipsToggle", "rendersWhen": "the epic holds at least one slice", "removedWhen": "the epic holds no slice" },
      { "control": "NoProgramCard", "rendersWhen": "orphans > 0 and at least one orphan slice matches the search", "removedWhen": "orphans is 0, or the search hides every orphan slice" },
      { "control": "BoardNoMatch", "rendersWhen": "every column of the board is empty because of the search", "removedWhen": "the search is empty, or one column holds a card" },
      { "control": "UnknownProgramNotice", "rendersWhen": "the address program value is not in the index", "removedWhen": "any address write, or its Close button" },
      { "control": "BackLink", "rendersWhen": "the board is the epic board or the No program board", "removedWhen": "the board is the program board" },
      { "control": "TopBarBoardLink", "rendersWhen": "always", "removedWhen": "never" },
      { "control": "FindField", "rendersWhen": "always on the board. It is disabled, not gated, while the index loads", "removedWhen": "never" }
    ],

    "defaults": {
      "board": "programs",
      "searchText": "",
      "sort": "name",
      "cards": "epics",
      "hiddenColumnsPrograms": ["superseded"],
      "hiddenColumnsEpics": [],
      "hiddenColumnsOrphans": [],
      "epicSliceList": "collapsed",
      "orphanSliceCard": "collapsed",
      "columnScrollTop": 0,
      "notice": null,
      "theme": "light",
      "workDrawer": "closed"
    },

    "timingTokens": {
      "--motion-hover": "150ms",
      "--motion-panel": "180ms",
      "--motion-notice": "140ms",
      "--hold-ack": "1800ms",
      "--motion-skeleton": "2000ms"
    },

    "layering": {
      "base": { "token": "--layer-base", "surfaces": ["KanbanPage"], "collisionRule": "the board is the page and sits under everything else" },
      "raised": { "token": "--layer-raised", "surfaces": ["ColumnHead"], "collisionRule": "cards scroll under a column head and never over it" },
      "panel": { "token": "--layer-panel", "surfaces": ["CopyNotice", "UnknownProgramNotice"], "collisionRule": "the notice floats over the board's top right corner and yields to any dialog" },
      "chrome": { "token": "--layer-fixed", "surfaces": ["TopBar", "Rail"], "collisionRule": "yields to any panel or dialog" },
      "modal": { "token": "--layer-modal", "surfaces": ["WorkDrawer"], "collisionRule": "above the board and above the notice. The board does not scroll while it is open" }
    },

    "hitTargets": [
      { "control": "ProgramCard", "eventElement": "the card's own a, stretched by ::after at inset 0", "clickableBounds": "the whole card except the name and the copy button", "ancestorPointerEvents": "auto", "restorePointerEvents": "auto" },
      { "control": "ProgramNameLink", "eventElement": "the a around the name text", "clickableBounds": "the text box and its underline", "ancestorPointerEvents": "auto", "restorePointerEvents": "auto", "note": "relative z-10, above the card overlay" },
      { "control": "CopyPromptButton", "eventElement": "the button, 32 by 32 px", "clickableBounds": "the button box around a 14 px icon", "ancestorPointerEvents": "auto", "restorePointerEvents": "auto", "note": "relative z-10, above the card overlay" },
      { "control": "EpicCard", "eventElement": "the head block's a, stretched by ::after over the head only", "clickableBounds": "the head block, never the pips row or the slice list", "ancestorPointerEvents": "auto", "restorePointerEvents": "auto" },
      { "control": "SlicePipsToggle", "eventElement": "the whole pips row button", "clickableBounds": "the full row width, 22 px tall", "ancestorPointerEvents": "auto", "restorePointerEvents": "auto" },
      { "control": "SliceCard", "eventElement": "the a around the whole card", "clickableBounds": "the whole card", "ancestorPointerEvents": "auto", "restorePointerEvents": "auto" },
      { "control": "OrphanSliceCard", "eventElement": "the button around the whole row", "clickableBounds": "the whole row", "ancestorPointerEvents": "auto", "restorePointerEvents": "auto" },
      { "control": "HideButton", "eventElement": "the button, 28 px tall", "clickableBounds": "the button box, not the column head", "ancestorPointerEvents": "auto", "restorePointerEvents": "auto" },
      { "control": "HiddenColumnRail", "eventElement": "the rail button", "clickableBounds": "the full 44 px width and the full column height", "ancestorPointerEvents": "auto", "restorePointerEvents": "auto" },
      { "control": "FindField", "eventElement": "the input", "clickableBounds": "32 px tall and up to 340 px wide. The Find label focuses it", "ancestorPointerEvents": "auto", "restorePointerEvents": "auto" },
      { "control": "OrderSelect", "eventElement": "the select", "clickableBounds": "the control box, 32 px tall", "ancestorPointerEvents": "auto", "restorePointerEvents": "auto" },
      { "control": "CardsSwitch", "eventElement": "each button", "clickableBounds": "the button box, 32 px tall", "ancestorPointerEvents": "auto", "restorePointerEvents": "auto" },
      { "control": "BackLink", "eventElement": "the a", "clickableBounds": "the label text and the arrow", "ancestorPointerEvents": "auto", "restorePointerEvents": "auto" },
      { "control": "CopyNotice", "eventElement": "the Close button", "clickableBounds": "the button box, 28 px tall", "ancestorPointerEvents": "none on the layer, auto on the notice", "restorePointerEvents": "auto" },
      { "control": "TopBarBoardLink", "eventElement": "the a", "clickableBounds": "44 by 44 px", "ancestorPointerEvents": "auto", "restorePointerEvents": "auto" }
    ],

    "scrollOwnership": [
      { "region": "the document", "owner": "nothing", "other": "html and body carry no overflow, and the shell fills its host", "overflow": "clip" },
      { "region": "the shell pane on the board route", "owner": "the pane, on both axes, as the shell's contract says", "other": "the board fits the pane, so the pane never overflows on this route", "overflow": "auto" },
      { "region": "each column body", "owner": "the column, vertically, with overscroll-contain", "other": "the column head stays still and the other columns do not move", "overflow": "auto" },
      { "region": "the row of columns when the pane is narrower than 960 px", "owner": "the column row, horizontally", "other": "the page never scrolls sideways", "overflow": "auto" },
      { "region": "the epic slice list", "owner": "nothing. The list grows and the column scrolls", "other": "the card never nests a scroller", "overflow": "clip" },
      { "region": "the card corner", "owner": "nothing", "other": "the clip keeps the radius and claims no gesture", "overflow": "clip" },
      { "region": "the Work drawer over the board", "owner": "the drawer, as ADR-0034 decides", "other": "the board behind it does not scroll", "overflow": "clip" }
    ]
  },

  "accessibility": {
    "landmarks": {
      "pane": "the shell pane is labelled Kanban board, Kanban board, <program>, or Kanban board, No program",
      "page": "one h1, Kanban board. The subject is an h2 on the two lower boards",
      "columns": "each column is a section with aria-labelledby pointing at its heading and its count"
    },
    "labels": {
      "boardRegion": "aria-busy='true' while the index loads",
      "counts": "aria-label='Shown counts' on the description list",
      "cardsSwitch": "role='group' aria-label='Cards', each button with aria-pressed",
      "pipsToggle": "Show the 3 slices of <label>, and Hide the 3 slices of <label> when open",
      "hideButton": "visible word Hide, accessible name Hide Superseded",
      "rail": "Show Superseded, 4 programs",
      "copyButton": "Copy the start prompt for <name>",
      "cardTarget": "Open the epic board of <name>, Open epic <label>, or Open slice 3 of <epic label>",
      "orphanCard": "Show the end state, score, and attempts of <title>",
      "epicBar": "aria-hidden, because the counts line states the same numbers in text"
    },
    "keyboard": {
      "focusOrder": "skip link, top bar, rail, the heading band's links, Find, Order or Cards, then each column in turn: its Hide, then each card's target, name, and copy",
      "slashFocusesFind": "on the board, when no [role=dialog] is open and focus is not in a field, select, or textarea",
      "escape": "dismisses a notice when no dialog is open. With the Work drawer open, vaul closes the drawer and the notice stays",
      "arrows": "not bound on the board. Tab is the walk, and the Work drawer keeps its own arrows",
      "focusOnLevelChange": "moves to the band's subject heading, which carries tabIndex -1 and receives focus with preventScroll",
      "noTrap": "no board container traps focus. The Work drawer traps focus while it is open"
    },
    "screenReader": {
      "statusAnnounce": "one role='status' aria-live='polite' aria-atomic='true' region holds Prompt copied, Copy failed, or the unknown program sentence",
      "loadingAnnounce": "one polite live region states Loading the record index",
      "countAnnounce": "a column reads Planned 4, and the header reads Programs, 22 of 26"
    },
    "colourIndependence": {
      "status": "the shape glyph and the raw status word carry the state with the colour",
      "progress": "the counts line states the three numbers beside the bar",
      "hidden": "the vertical label and the count state a hidden column without its fill",
      "notice": "the words Prompt copied and Copy failed carry the result"
    }
  },

  "stateManagement": {
    "required": false,
    "note": "The board adds no store. The address holds the board, the search, the sort, the card grain, the hidden columns, and the open program. The data layer resolves every record, column, and count from data/index.json. Component state holds three things only: the open epic slice list, the open orphan slice card, and the notice.",
    "addressKeys": ["program", "orphans", "q", "sort", "hide", "cards"],
    "history": {
      "replace": ["q"],
      "push": ["program", "orphans", "sort", "cards", "hide"]
    },
    "componentState": {
      "expandedEpicSlices": "Set<string> of epic ids, cleared on a board change",
      "expandedOrphanCard": "string | null, one slice id, cleared on a search change",
      "notice": "{ kind: 'copied', at: number } | { kind: 'failed', prompt: string } | { kind: 'unknown-program', value: string } | null"
    }
  }
}
