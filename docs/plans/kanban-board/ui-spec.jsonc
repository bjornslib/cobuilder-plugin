// ui-spec: kanban-board
// Gate 2b, step 3. The boards, their controls, and the contracts that cross
// component boundaries. Values come from docs/plans/kanban-board/interaction-design.md.
// Colours map to the viewer's own tokens in plugins/artifact/viewer/src/index.css.
// No literal colour and no literal duration appears in this file.
//
// Source: the engineer-approved prototype
// docs/architecture/designs/kanban-board/prototypes/option-d-program-drilldown.html.
// Its pivot, multi-select, and in-page detail panel are dead code and are absent here.
// contracts.md wins where the prototype differs: the address is #/board?program=<id>,
// the No program board is #/board?orphans=1, and the column control is named Hide.
{
  "metadata": {
    "name": "KanbanBoard",
    "description": "A read-only, two-level Kanban board page of the viewer. Programs sit in five stage columns, and a program opens three status columns of epics or slices.",
    "route": "#/board",
    "version": "1.0",
    "source": {
      // The schema names four tools. An approved in-repo prototype is a fifth
      // source, and this is it. The file is static HTML and CSS, so it is
      // authoritative for layout and structure only.
      "tool": "PrototypeHtml",
      "hasHtmlCss": true,
      "codeFile": "docs/architecture/designs/kanban-board/prototypes/option-d-program-drilldown.html",
      "decisions": ["docs/architecture/designs/kanban-board/contracts.md", "ADR-0050"],
      "approvedMockup": "docs/plans/kanban-board/mockups/program-board-and-epic-board.html"
    }
  },

  "layout": {
    "type": "page",
    "structure": {
      // The page fills the shell pane and never grows past it. The pane is the
      // shell's only scroll region, and it does not overflow on this route.
      "container": "flex h-full min-h-0 min-w-0 flex-col bg-ground",
      "headingBand": "flex min-h-14 shrink-0 items-center gap-3 px-4 py-1.5 bg-band text-band-ink",
      "commandRow": "flex h-12 shrink-0 items-center gap-4 border-b border-line bg-surface px-4",
      "noProgramCard": "mx-4 mt-3 shrink-0",
      "noticeLayer": "pointer-events-none absolute right-3 top-2 z-(--layer-panel) flex w-full max-w-[440px] justify-end",
      "boardRegion": "relative flex min-h-0 min-w-0 flex-1 flex-col",
      "columnRow": "flex min-h-0 min-w-0 flex-1 gap-3 overflow-x-auto overflow-y-clip px-4 py-3",
      "column": "flex min-w-[176px] min-h-0 flex-1 basis-0 flex-col rounded-lg border border-line bg-surface-2",
      "columnHead": "flex h-10 shrink-0 items-center gap-1.5 overflow-clip rounded-t-lg border-b border-line bg-surface px-2.5",
      "columnBody": "flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto overscroll-contain p-2",
      "hiddenRail": "flex w-11 shrink-0 flex-col items-center gap-2 overflow-clip rounded-lg border border-line bg-surface-2 py-3 text-ink-dim"
    },
    "responsive": {
      // 1280 x 800: pane 1024 px, so five columns of 188.8 px and no page-level
      // sideways scroll. The abort_if of goal.json binds here.
      "lg": "Five columns at 176 px or wider each, sharing the pane width. Each column scrolls inside itself.",
      "md": "The pane is narrower than 960 px, so the column row scrolls sideways inside itself. Columns keep the 176 px floor and never stack.",
      "sm": "The rail becomes the shell's drawer, so the pane takes the full width. The column row still scrolls sideways, and every control takes a 44 px target under a coarse pointer."
    }
  },

  "sections": [
    {
      "id": "heading-band",
      "description": "The page title, the level's subject, the three shown counts, the build time, and the back link on the two lower boards.",
      "layout": "flex min-w-0 items-center gap-3",
      "components": ["BoardHeadingBand", "BackLink", "CountsBlock", "BuildTime"],
      "responsive": {
        "lg": "One row. The counts and the build time sit in a right-aligned block of two lines.",
        "sm": "The subject heading truncates, and the counts keep their three pairs."
      }
    },
    {
      "id": "command-row",
      "description": "Find on every board. Order on the program board. Cards on the epic board. Each group is divided by a 1 px line.",
      "layout": "flex min-w-0 items-center gap-0",
      "components": ["FindField", "OrderSelect", "CardsSwitch"],
      "responsive": {
        "lg": "Find takes the free width up to 340 px, and the gated groups sit at the end.",
        "sm": "Groups wrap-free: Find shrinks to 120 px, and the labels stay visible."
      }
    },
    {
      "id": "notices",
      "description": "One floating notice over the board's top right corner: Prompt copied, Copy failed, or the unknown program sentence.",
      "layout": "pointer-events-none",
      "components": ["CopyNotice", "UnknownProgramNotice"]
    },
    {
      "id": "no-program-card",
      "description": "One full-width card between the command row and the columns, present only when orphan slices exist.",
      "layout": "h-11",
      "components": ["NoProgramCard"]
    },
    {
      "id": "columns",
      "description": "The column row. Five stage columns on the program board, three status columns on the epic board and the No program board.",
      "layout": "flex min-h-0 min-w-0 flex-1 gap-3 overflow-x-auto px-4 py-3",
      "components": ["ColumnHead", "HideButton", "HiddenColumnRail", "ProgramCard", "EpicCard", "SliceCard", "OrphanSliceCard", "EmptyColumnNotice", "BoardNoMatch"]
    },
    {
      "id": "work-drawer",
      "description": "The ADR-0034 drawer over the board. It is unchanged, and the board adds nothing to it.",
      "components": ["WorkDrawerEntry"]
    }
  ],

  "components": [
    {
      "name": "KanbanPage",
      "description": "The page frame. It renders the band and the command row at first paint, and the board region follows the index load.",
      "instances": 1,
      "props": {
        "board": "'programs' | 'epics' | 'orphans'",
        "load": "{ state: 'loading' } | { state: 'ready', index: RecordIndex } | { state: 'failed', message: string }",
        "model": "BoardModel | null"
      },
      "structure": {
        "container": "flex h-full min-h-0 min-w-0 flex-col bg-ground",
        "boardRegion": "relative flex min-h-0 min-w-0 flex-1 flex-col",
        "loadingRegion": "aria-busy='true'",
        "skeletonColumn": "flex min-w-[176px] flex-1 basis-0 flex-col gap-2 rounded-lg border border-line bg-surface-2 p-2"
      },
      "interaction": {
        "states": [
          { "name": "loading", "class": "loading", "initial": false, "timerArming": { "starts": "on the index request", "resets": "when the request settles" } },
          { "name": "default", "class": "default", "initial": true, "timerArming": null },
          { "name": "empty", "class": "empty", "initial": false, "timerArming": null },
          { "name": "error", "class": "error", "initial": false, "timerArming": null }
        ],
        "notApplicable": ["hover", "focus-visible", "pressed", "selected", "disabled", "transient"]
      },
      "sampleData": [
        { "board": "programs", "shown": 22, "total": 26 }
      ]
    },
    {
      "name": "BoardHeadingBand",
      "description": "The one heading band. It carries the h1 Kanban board, the subject heading on the two lower boards, the counts, and the build time.",
      "instances": 1,
      "props": {
        "subject": "string | null",
        "counts": "{ programs?: { shown: number, total: number }, epics?: { shown: number, total: number }, slices: { shown: number, total: number } }",
        "builtAt": "string | null"
      },
      "structure": {
        "band": "flex min-h-14 min-w-0 items-center gap-3 px-4 py-1.5 bg-band text-band-ink",
        "title": "m-0 shrink-0 font-mono text-[13px] font-bold tracking-[0.02em] uppercase",
        "subject": "m-0 min-w-0 truncate font-serif text-[15px] leading-tight text-band-ink",
        "rule": "h-4 w-px shrink-0 bg-band-ink/40",
        "counts": "ml-auto flex shrink-0 items-baseline gap-5",
        "countLabel": "font-mono text-[10px] tracking-[0.12em] uppercase",
        "countValue": "font-mono text-[13px] font-semibold tabular-nums",
        "buildTime": "font-mono text-[11px] text-band-ink"
      }
    },
    {
      "name": "CountsBlock",
      "description": "A description list of the shown counts. The unit lives in the label, so a screen reader reads Programs, 22 of 26.",
      "instances": 1,
      "props": {
        "pairs": "Array<{ label: string, shown: number, total: number }>"
      },
      "structure": {
        "list": "dl aria-label='Shown counts' m-0 flex items-baseline gap-5",
        "pair": "flex items-baseline gap-1.5",
        "label": "font-mono text-[10px] tracking-[0.12em] uppercase",
        "value": "font-mono text-[13px] font-semibold tabular-nums"
      }
    },
    {
      "name": "BuildTime",
      "description": "The build time of the record index as a time element in the reader's own time zone.",
      "instances": 1,
      "props": {
        "builtAt": "string | null"
      },
      "structure": {
        "time": "font-mono text-[11px] text-band-ink",
        "missing": "font-mono text-[11px] text-band-ink"
      },
      "sampleData": [
        { "builtAt": "2026-11-21T09:41:00Z" },
        { "builtAt": null }
      ]
    },
    {
      "name": "BackLink",
      "description": "The link from a lower board to the program board. It keeps the search and drops the other query keys of the lower board.",
      "instances": 1,
      "props": {
        "q": "string",
        "href": "string"
      },
      "structure": {
        "link": "inline-flex h-8 shrink-0 items-center gap-1.5 rounded-md px-1.5 font-mono text-[12.5px] font-bold text-band-ink hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
        "icon": "size-3.5"
      },
      "interaction": {
        "classes": { "default": "text-band-ink" },
        "states": [
          { "name": "default", "class": "default", "initial": true, "timerArming": null },
          { "name": "hover", "class": "hoverInBand", "initial": false, "timerArming": null },
          { "name": "focus-visible", "class": "focusVisible", "initial": false, "timerArming": null },
          { "name": "pressed", "class": "pressedInBand", "initial": false, "timerArming": null }
        ],
        "notApplicable": ["selected", "disabled", "loading", "error", "empty", "transient"]
      }
    },
    {
      "name": "FindField",
      "description": "The one text search of the board. It replaces the address on each key press, so each press adds no history entry.",
      "instances": 1,
      "props": {
        "value": "string",
        "onChange": "(text: string) => void",
        "disabled": "boolean",
        "inputRef": "RefObject<HTMLInputElement>"
      },
      "structure": {
        "group": "flex min-w-0 flex-1 items-center gap-2",
        "label": "shrink-0 font-mono text-[10px] tracking-[0.12em] uppercase text-ink-dim",
        "input": "h-8 w-full max-w-[340px] min-w-0 rounded-md border border-line bg-surface px-2.5 font-mono text-[12.5px] text-ink outline-none placeholder:text-ink-faint",
        "inputFocus": "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
        "inputHover": "hover:border-ink-faint",
        "inputDisabled": "disabled:opacity-45 disabled:cursor-not-allowed"
      },
      "interaction": {
        "states": [
          { "name": "default", "class": "default", "initial": true, "timerArming": null },
          { "name": "hover", "class": "hover", "initial": false, "timerArming": null },
          { "name": "focus-visible", "class": "focusVisible", "initial": false, "timerArming": null },
          { "name": "disabled", "class": "disabled", "initial": false, "timerArming": null },
          { "name": "empty", "class": "empty", "initial": false, "timerArming": null }
        ],
        "notApplicable": ["pressed", "selected", "loading", "error", "transient"]
      },
      "sampleData": [{ "value": "", "placeholder": "Program, epic, or slice. Press / to focus" }]
    },
    {
      "name": "OrderSelect",
      "description": "The sort of the program cards inside each column. It is gated to the program board.",
      "instances": 1,
      "props": {
        "value": "'name' | 'open' | 'progress'",
        "onChange": "(value: string) => void"
      },
      "structure": {
        "group": "flex shrink-0 items-center gap-2 border-l border-line pl-4",
        "label": "font-mono text-[10px] tracking-[0.12em] uppercase text-ink-dim",
        "select": "h-8 rounded-md border border-line bg-surface px-2 font-mono text-[12px] text-ink hover:bg-surface-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      },
      "interaction": {
        "states": [
          { "name": "default", "class": "default", "initial": true, "timerArming": null },
          { "name": "hover", "class": "hover", "initial": false, "timerArming": null },
          { "name": "focus-visible", "class": "focusVisible", "initial": false, "timerArming": null },
          { "name": "pressed", "class": "native", "initial": false, "timerArming": null },
          { "name": "selected", "class": "native", "initial": false, "timerArming": null }
        ],
        "notApplicable": ["disabled", "loading", "error", "empty", "transient"]
      },
      "sampleData": [
        { "value": "name", "options": ["Name", "Most open work", "Progress"] }
      ]
    },
    {
      "name": "CardsSwitch",
      "description": "The grain of the epic board: epics, or slices. It is gated to the epic board.",
      "instances": 1,
      "props": {
        "value": "'epics' | 'slices'",
        "onChange": "(value: 'epics' | 'slices') => void"
      },
      "structure": {
        "group": "flex shrink-0 items-center gap-2 border-l border-line pl-4",
        "label": "font-mono text-[10px] tracking-[0.12em] uppercase text-ink-dim",
        "segmented": "inline-flex overflow-clip rounded-full border border-line bg-surface",
        "button": "h-8 px-3 font-mono text-[12px] text-ink-mid hover:bg-surface-2 hover:text-foreground",
        "buttonSelected": "bg-accent-wash text-accent-deep font-bold",
        "buttonFocus": "focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring"
      },
      "interaction": {
        "states": [
          { "name": "default", "class": "default", "initial": true, "timerArming": null },
          { "name": "hover", "class": "hover", "initial": false, "timerArming": null },
          { "name": "focus-visible", "class": "focusVisible", "initial": false, "timerArming": null },
          { "name": "pressed", "class": "pressed", "initial": false, "timerArming": null },
          { "name": "selected", "class": "selected", "initial": false, "timerArming": null }
        ],
        "notApplicable": ["disabled", "loading", "error", "empty", "transient"]
      },
      "sampleData": [{ "value": "epics" }]
    },
    {
      "name": "ColumnHead",
      "description": "One column head: the stage badge or status pill, the count that hugs it, and the Hide control at the end. The head does not scroll with the cards.",
      "instances": 5,
      "props": {
        "kind": "'stage' | 'status'",
        "label": "string",
        "shape": "'circle' | 'half' | 'filled' | null",
        "count": "number",
        "columnKey": "string",
        "hideDisabled": "boolean"
      },
      "structure": {
        "head": "flex h-10 shrink-0 items-center gap-1.5 overflow-clip rounded-t-lg border-b border-line bg-surface px-2.5",
        "badge": "inline-flex shrink-0 items-center gap-1 rounded border border-line bg-surface-2 px-1.5 py-px font-mono text-[10px] tracking-[0.06em] uppercase text-ink-mid",
        "badgeStage": { "decision": "border-warn text-warn", "build": "border-primary text-accent-deep", "review": "border-tint bg-tint text-tint-ink", "shipped": "border-good text-good", "superseded": "border-dashed border-line text-ink-dim" },
        "badgeStatus": { "planned": "text-ink-dim", "in_progress": "text-warn", "done": "text-good" },
        "count": "ml-0 font-mono text-[12px] font-bold tabular-nums text-ink",
        "grow": "ml-auto",
        "heading": "sr-only"
      },
      "sampleData": [
        { "kind": "stage", "label": "Shipped", "count": 1 },
        { "kind": "status", "label": "Done", "shape": "filled", "count": 13 }
      ]
    },
    {
      "name": "HideButton",
      "description": "One Hide control on each visible column head. Its visible word is Hide, and its accessible name names the column.",
      "instances": 5,
      "props": {
        "columnLabel": "string",
        "columnKey": "string",
        "disabled": "boolean",
        "onHide": "() => void"
      },
      "structure": {
        "button": "inline-flex h-7 shrink-0 cursor-pointer items-center rounded border border-line bg-surface px-2 font-mono text-[10.5px] text-ink-mid hover:bg-surface-2 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
        "disabled": "disabled:pointer-events-none disabled:opacity-45"
      },
      "interaction": {
        "states": [
          { "name": "default", "class": "default", "initial": true, "timerArming": null },
          { "name": "hover", "class": "hover", "initial": false, "timerArming": null },
          { "name": "focus-visible", "class": "focusVisible", "initial": false, "timerArming": null },
          { "name": "pressed", "class": "pressed", "initial": false, "timerArming": null },
          { "name": "disabled", "class": "disabled", "initial": false, "timerArming": null }
        ],
        "notApplicable": ["selected", "loading", "error", "empty", "transient"]
      },
      "sampleData": [{ "columnLabel": "Superseded", "disabled": false }]
    },
    {
      "name": "HiddenColumnRail",
      "description": "A hidden column as a 44 px rail. The rail states the column label vertically and the count, and one press shows the column again.",
      "instances": 1,
      "props": {
        "columnKey": "string",
        "columnLabel": "string",
        "count": "number",
        "onShow": "() => void"
      },
      "structure": {
        "rail": "flex w-11 shrink-0 flex-col items-center gap-2 overflow-clip rounded-lg border border-line bg-surface-2 py-3 text-ink-dim hover:bg-accent-wash hover:text-accent-deep",
        "label": "[writing-mode:vertical-rl] rotate-180 font-mono text-[10.5px] tracking-[0.1em] uppercase whitespace-nowrap",
        "count": "font-mono text-[13px] font-bold tabular-nums",
        "focus": "focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring"
      },
      "interaction": {
        "states": [
          { "name": "default", "class": "default", "initial": true, "timerArming": null },
          { "name": "hover", "class": "selected", "initial": false, "timerArming": null },
          { "name": "focus-visible", "class": "focusVisible", "initial": false, "timerArming": null },
          { "name": "pressed", "class": "pressed", "initial": false, "timerArming": null },
          { "name": "empty", "class": "empty", "initial": false, "timerArming": null }
        ],
        "notApplicable": ["selected", "disabled", "loading", "error", "transient"]
      },
      "sampleData": [{ "columnLabel": "Superseded", "count": 4 }]
    },
    {
      "name": "ProgramCard",
      "description": "One program in its stage column: name, outcome, epic bar, the three epic counts, and the slice footer. The card body opens the epic board, and the name opens the program.",
      "instances": 26,
      "props": {
        "program": "{ id: string, name: string, outcome: string, stage: string }",
        "counts": "{ planned: number, inProgress: number, done: number }",
        "slices": "{ total: number, done: number, nextReadyN: number | null }",
        "prompt": "string | null"
      },
      "structure": {
        "card": "group relative flex flex-col gap-1.5 overflow-clip rounded-lg border border-line bg-surface p-2.5 shadow-card transition-colors duration-150 ease-house hover:border-primary hover:shadow-raise focus-within:border-primary",
        "targetLink": "absolute inset-0 rounded-lg after:absolute after:inset-0 after:content-[''] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
        "name": "relative z-10 m-0 font-mono text-[13px] font-bold break-words text-ink underline decoration-line decoration-1 underline-offset-[3px] hover:decoration-primary hover:text-accent-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
        "outcome": "m-0 line-clamp-2 font-serif text-[12px] leading-[1.4] text-ink-mid",
        "bar": "flex h-1.5 gap-0.5 overflow-clip rounded-sm bg-surface-3",
        "counts": "flex flex-wrap gap-x-2.5 gap-y-0.5 font-mono text-[10.5px] tabular-nums",
        "footer": "font-mono text-[10.5px] text-ink-dim",
        "copySlot": "absolute right-1.5 top-1.5 z-10"
      },
      "interaction": {
        "states": [
          { "name": "default", "class": "default", "initial": true, "timerArming": null },
          { "name": "hover", "class": "cardHover", "initial": false, "timerArming": null },
          { "name": "focus-visible", "class": "focusVisible", "initial": false, "timerArming": null },
          { "name": "pressed", "class": "pressed", "initial": false, "timerArming": null }
        ],
        "notApplicable": ["selected", "disabled", "loading", "error", "empty", "transient"]
      },
      "sampleData": [
        {
          "program": { "id": "kanban-board", "name": "kanban-board", "outcome": "A reader sees every program by stage, then the epics of one program.", "stage": "approved" },
          "counts": { "planned": 3, "inProgress": 2, "done": 1 },
          "slices": { "total": 6, "done": 3, "nextReadyN": 4 },
          "prompt": "/implement:start kanban-board"
        }
      ]
    },
    {
      "name": "ProgramNameLink",
      "description": "The name on a program card. It opens the program's own page and sits above the card's stretched target.",
      "instances": 26,
      "props": { "programId": "string", "name": "string" },
      "structure": {
        "link": "relative z-10 font-mono text-[13px] font-bold break-words text-ink underline decoration-line underline-offset-[3px] hover:decoration-primary hover:text-accent-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      },
      "interaction": {
        "states": [
          { "name": "default", "class": "default", "initial": true, "timerArming": null },
          { "name": "hover", "class": "hover", "initial": false, "timerArming": null },
          { "name": "focus-visible", "class": "focusVisible", "initial": false, "timerArming": null },
          { "name": "pressed", "class": "pressed", "initial": false, "timerArming": null }
        ],
        "notApplicable": ["selected", "disabled", "loading", "error", "empty", "transient"]
      }
    },
    {
      "name": "EpicCard",
      "description": "One epic in a status column. The head opens the epic page, the pips toggle shows the slices in place, and the copy icon copies the prompt. The card keeps the raw status word.",
      "instances": 112,
      "props": {
        "epic": "{ id: string, epicId: string, title: string | null, status: string, lifecycle: 'open' | 'closed', pr: number | null, branch: string | null }",
        "slices": "Array<{ n: number, title: string, state: string, score: string | null }>",
        "slicesDone": "boolean",
        "prompt": "string | null"
      },
      "structure": {
        "card": "overflow-clip rounded-lg border border-line-soft bg-surface shadow-card",
        "statusRule": { "planned": "border-l-[3px] border-l-ink-faint", "in_progress": "border-l-[3px] border-l-warn", "done": "border-l-[3px] border-l-good" },
        "head": "relative p-2",
        "targetLink": "absolute inset-0 after:absolute after:inset-0 after:content-[''] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
        "identity": "flex items-baseline gap-1.5 pr-8",
        "epicId": "shrink-0 font-mono text-[10.5px] font-bold tracking-[0.04em] text-ink-dim",
        "label": "min-w-0 truncate font-mono text-[12px] font-semibold text-ink",
        "meta": "mt-1.5 flex flex-wrap items-center gap-1.5",
        "statusPill": { "planned": "bg-surface-3 text-ink-dim", "in_progress": "bg-warn-wash text-warn", "done": "bg-good-wash text-good" },
