%% review-flight-deck level 3 — the record shapes
classDiagram
    class OpenSet {
        +str base_sha
        +list~int~ open
        +list~int~ auto_merged
        +list~int~ described_by_generate
        +str read_at
    }
    class Path {
        +str path_id
        +str name
        +list~Bundle~ bundles
        +list~Blocked~ blocked
        +list~str~ outcome
        +list~str~ not_included
        +str status
    }
    class Bundle {
        +int n
        +str slug
        +list~int~ prs
        +str branch
        +str from_ref
        +str why
    }
    class Blocked {
        +int pr
        +str kind
        +str file
        +str span
        +list~Option~ options
    }
    class Replay {
        +str path_id
        +str base_sha
        +int conflicts
        +list~str~ unassessed
        +run_on_scratch_worktree() Replay
    }
    class PathAccept {
        +str type
        +str picked
        +list~str~ refused
        +str rollout
        +str validated_with
        +str ts
    }
    class MergeBundle {
        +str type
        +int bundle
        +list~int~ prs
        +str onto
        +str from_ref
        +str ts
    }

    OpenSet "1" --> "1..*" Path : simulated into
    Path "1" *-- "1..*" Bundle : ordered as
    Path "1" o-- "0..*" Blocked : cannot carry
    Path "1" <-- "0..1" Replay : validated by
    Path "1" <-- "0..1" PathAccept : accepted by
    PathAccept "1" --> "1..*" MergeBundle : authorises
    Bundle "1" <-- "0..1" MergeBundle : performed by

    note for OpenSet "base_sha is the merge-base of every open head.\nNever the default branch."
    note for Bundle "branch is flightdeck/<path>/<n>-<slug>.\nfrom_ref is the previous bundle's branch."
    note for Blocked "kind is superseded or conflict.\nA conflict needs a person, not a retry."
    note for Replay "A snapshot against recorded heads.\nA push after the run invalidates it."
