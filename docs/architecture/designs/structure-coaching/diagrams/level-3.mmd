classDiagram
    class StructureSignals {
        +signals_for
        +print_findings_json
    }
    class Signal {
        <<interface>>
        +check
    }
    class CrowdedFolder {
        +folder_limit
        +groups
    }
    class NameFamily {
        +shared_first_token
    }
    class GenericName {
        +generic_names
    }
    class BoundaryEdge {
        +read_boundary_records
        +outside_allowed
    }
    class NewCodeRule {
        +new_files_on_branch
        +slice_diff
    }
    class StructureEvidence {
        +evidence_packet
        +contract_drift
        +vocabulary_leads
    }
    class FindingsJson {
        +signal
        +path
        +facts
    }
    class NotAnalysedList {
        +paths
        +reason
    }

    Signal <|.. CrowdedFolder
    Signal <|.. NameFamily
    Signal <|.. GenericName
    Signal <|.. BoundaryEdge
    StructureSignals --> NewCodeRule : keeps only new files
    StructureSignals --> Signal : runs each
    StructureSignals --> FindingsJson : prints
    StructureSignals --> NotAnalysedList : prints
    StructureEvidence --> NewCodeRule : reads the slice diff
    StructureEvidence --> BoundaryEdge : reuses
    StructureEvidence --> FindingsJson : writes the packet

    note for StructureSignals "standard library only\nthe coach runs it on each GREEN write"
    note for StructureEvidence "uv run, may use tree-sitter and PyYAML\nVALIDATE runs it on the slice diff"
    note for CrowdedFolder "default limit 20, a guess\nthe replay evaluation tunes it"
