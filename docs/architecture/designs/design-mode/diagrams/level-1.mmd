C4Container
title cobuilder-architect after design mode

Person(eng, "Engineer", "Designs, then submits")
Person(rev, "Reviewer", "Reads docs/ and the viewer")

System_Boundary(plugin, "cobuilder-architect") {
  Container(design, "Design mode", "odyssey", "Seven stages, self-only")
