C4Container
title Tracker port and beads adapter for CoBuilder — level 1

Container(sessions, "CoBuilder sessions", "architect, implement, pr plugins", "Local, cloud, and team sessions: author designs, run ladders, narrate change")
Container(cli, "shared/tracker.py", "Python, PEP 723, uv run", "The one command agents call: one subcommand for each port operation, JSON out, exit 2 with no adapter")
Container(ref, "shared/tracker-usage.md", "Markdown reference", "Teaches agents when to run each command, and each main SKILL.md links it")
Container(port, "shared/tracker port", "Python: TrackerPort, TrackerRecord", "Neutral reads and writes of workflow state, seed-from-files, and capabilities()")
Container(projector, "Projector", "Python, in shared/tracker", "Turns TrackerRecord lists into entities, joins, and data/index.json")
Container(beads, "beads adapter", "Python, calls bd", "First adapter: maps records to issues and the metadata.cb envelope")
Container(files, "files adapter", "Python", "Reads today's files, refuses writes")
Container(fake, "fake adapter", "Python, in memory", "Loads fixtures from tests/fixtures/tracker, proves the seam in the contract test")
Container(later, "linear and jira adapters", "Later programs, not built here", "Call the API, may cache inside the adapter")
Container(bd, "bd 1.3.0", "CLI + embedded Dolt", "Master of programs, epics, slices, and pull request issues")
ContainerDb(central, "Central store (proposed, not verified)", "Dolt-in-git, refs/dolt/data", "One shared backlog, synced with bd sync")
Container(backfill, "shared/tracker-backfill.md", "Markdown reference", "Agent workflow: inventory, dry run, consent, then seed-from-files create-only")
Container(build_index, "shared/build_index.py", "Python", "Reads through the port and the projector")
Container(contract, "Contract test", "pytest, in shared/tracker", "One suite that every adapter must pass")
Container(markdown, "docs/ + .cobuilder/", "Git-tracked files and tracker.yaml", "Prose, records, and the adapter config")
ContainerDb(indexjson, "data/index.json", "Static JSON", "The read model the viewer loads")
Container(viewer, "plugins/artifact/viewer", "Static single-file HTML", "Build-free viewer, reads index.json only")
System_Ext(github, "GitHub", "Git remote and pull requests")

Rel(sessions, ref, "read when state matters")
Rel(sessions, cli, "read and write state, an adapter is required", "uv run tracker.py")
Rel(cli, port, "calls the port", "Python call")
Rel(port, beads, "configured adapter", "tracker.yaml")
Rel(port, files, "read-only adapter, reads plans through slice_table")
Rel(port, fake, "in-memory adapter")
Rel(contract, port, "one suite runs against every adapter")
Rel(port, later, "later programs")
Rel(beads, bd, "every state write and read", "bd CLI")
Rel(bd, central, "bd sync pushes and pulls", "git refs/dolt/data")
Rel(central, github, "rides in the repo remote", "git")
Rel(backfill, cli, "runs seed-from-files after consent", "uv run tracker.py")
Rel(beads, markdown, "seed-from-files reads plans once, create-only")
Rel(build_index, port, "lists records")
Rel(build_index, projector, "projects the records it got from the port")
Rel(build_index, indexjson, "writes the index, full rebuild")
Rel(port, markdown, "reads tracker.yaml")
Rel(viewer, indexjson, "loads the static index")
Rel(sessions, github, "opens pull requests, reads merged state", "gh CLI")
