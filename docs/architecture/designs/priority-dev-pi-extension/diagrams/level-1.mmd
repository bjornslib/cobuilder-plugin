C4Container
    title priority-dev-pi-extension (ADR-0051) - one Reading contract for Claude Code, Pi and OMP

    Person(dev, "Developer", "Runs coding agents in Claude Code, Pi and OMP")

    Container_Boundary(pd, "priority-dev (Python leaf)") {
        Container(adapters, "transcript adapters", "Python", "claude-code and pi dialects write a priority transcript")
        Container(brief, "priority/brief", "Python", "Builds the brief from the priority transcript only")
        Container(cli, "priority read", "priority/cli.py", "Runs digest and interpret, prints one Reading as JSON")
    }

    Container_Boundary(core, "shared/priority-core (TypeScript)") {
        Container(coretypes, "priority-core", "TypeScript", "Reading types, card view model, draft, reader queue, pending record, ports")
        Container(evaluate, "evaluate", "TypeScript", "Pure gate: first DENY, then ASK, then ALLOW. Rules from schemas.md section 4 plus two ADR-0051 guards")
    }

    Container(ccplugin, "plugins/cobuilder-priority", "Claude Code host adapter", "Moves onto the core, keeps ADR-0049 and ADR-0050 behaviour")
    Container(piext, "pi/cobuilder-priority", "Pi and OMP host adapter", "agent_settled / session_stop, priority_read tool, question hook, plain-object pane")

    Container_Boundary(orch, "Pi Durable orchestrator (planned, epics E8 to E10; route chosen by probe E8)") {
        Container(child, "child agent (form chosen by E8)", "Pi Durable PiHarness, planned", "Candidate 1: container runs the Pi agent with pi/cobuilder-priority, stop hook runs priority read locally. Candidate 2: native Pi Durable extension with afterRun")
        Container(advisor, "advisor", "LLM, planned", "Proposes an answer or a notification")
        Container(actuator, "actuator", "TypeScript, planned", "Runs evaluate again, then submit, steer or signal")
        Container(attention, "attention + notifier", "TypeScript, planned", "Opens an attention item and notifies the person")
    }

    System_Ext(harness, "Claude Code / Pi / OMP", "Session files and stop events")

    Rel(harness, ccplugin, "Stop event")
    Rel(harness, piext, "Stop event")
    Rel(ccplugin, coretypes, "Imports via shared symlink")
    Rel(piext, coretypes, "Imports via shared symlink")
    Rel(coretypes, cli, "Runs as a process", "uv run priority read")
    Rel(cli, adapters, "Reads session file via")
    Rel(adapters, brief, "Priority transcript")
    Rel(brief, cli, "Brief")
    Rel(cli, coretypes, "Reading JSON", "stdout")
    Rel(ccplugin, dev, "Shows card, Send")
    Rel(piext, dev, "Shows card, Send")
    Rel(child, advisor, "child.reading", "DO RPC")
    Rel(advisor, evaluate, "Proposed action")
    Rel(actuator, evaluate, "Checks again before send")
    Rel(evaluate, actuator, "ALLOW")
    Rel(evaluate, attention, "ASK or DENY")
    Rel(actuator, harness, "submit / steer / signal")
    Rel(attention, dev, "Notifies")
