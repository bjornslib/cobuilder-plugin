%% Runtime architecture of the nexus-borrowings design.
%% Authored under the new runtime-architecture contract: clustered
%% boundaries, shape semantics, protocol-labeled edges, one page, 8-30 nodes.
%% Prediction: "pending" components exist only after this design ships.
C4Container
    title Design mode runtime: session, plugin prose, shared scripts, authored tree, index, viewer

    System_Boundary(client, "client") {
        Person(engineer, "Engineer", "States outcome, adjudicates stage 6, approves gates")
    }

    System_Boundary(api, "api") {
        System_Ext(session, "Claude Code session", "Runs design mode; spawned by implement or the engineer")
    }

    System_Boundary(data, "data") {
        ContainerDb(designsTree, "docs/architecture/designs/<name>/", "markdown + json", "goal, intent, assessment, narrative, pr-draft, contracts.md (pending)")
        ContainerDb(diagramsDir, "designs/<name>/diagrams/", "mermaid .mmd", "level-1..3 + runtime-architecture.mmd (pending)")
        ContainerDb(bundleIndex, ".cobuilder-architect/self/data/index.json", "record index", "designs entities with diagrams.runtime + contracts keys (pending)")
    }

    System_Boundary(infra, "infra") {
        Container(buildindex, "shared/build_index.py", "uv script", "Compile step; gains the runtime and contracts projections (pending)")
        Container(viewerBuild, "artifact viewer build", "Vite + tsc", "npm run build writes the committed viewer/index.html on viewer source change (ADR-0020)")
        Container(manifest, ".claude-plugin/marketplace.json", "manifest", "architect 0.7.0, implement 0.4.0, artifact 0.7.0 (pending)")
    }

    System_Boundary(external, "external") {
        System_Ext(reviewerSpawn, "Reviewer subagent", "One shot; cloud model glm-5.3-flash:cloud (pending)")
        System_Ext(gitRepo, "Target git repo", "The repo whose designs are compiled")
    }

    System_Boundary(architect_plugin, "architect plugin") {
        Container(designmode, "references/design-mode.md", "reference prose", "Stages 0-7; stage 5 gains the two artifacts, stage 6 gains the reviewer step (pending)")
        Container(archcontract, "mermaid references/architecture-diagram.md", "contract prose", "Runtime rules translated from Nexus _ARCH_SYSTEM (pending)")
    }

    System_Boundary(bundle_viewer, "bundle + viewer") {
        Container(viewer, "artifact viewer", "React app served by View", "Design route renders diagrams.runtime tile ahead of the class tile (pending)")
    }

    Rel(engineer, session, "drives design mode stages", "chat + AskUserQuestion")
    Rel(session, architect_plugin, "loads skill and references", "Skill resolve (CLAUDE_PLUGIN_ROOT)")
    Rel(architect_plugin, reviewerSpawn, "spawns once per stage-6 round with blind rubric", "Session subagent spawn (ADR-0005 pattern)")
    Rel(reviewerSpawn, session, "returns findings and survivor alternatives, never writes files", "Session return message")
    Rel(session, designsTree, "writes the five artifacts plus the new two", "filesystem write")
    Rel(session, diagramsDir, "writes level-1..3 and runtime-architecture.mmd", "filesystem write")
    Rel(session, buildindex, "compiles after the ADR lands", "uv run subprocess (PEP-723)")
    Rel(buildindex, gitRepo, "reads the authored tree", "filesystem read")
    Rel(buildindex, bundleIndex, "writes index.json full rebuild", "filesystem write")
    Rel(viewerBuild, designsTree, "migrate_bundle copies the built viewer into bundles", "build step")
    Rel(bundleIndex, viewer, "served to the design route", "HTTP (artifact View server)")
    Rel(viewer, engineer, "renders intent page with runtime tile lead", "browser render")
    Rel(manifest, architect_plugin, "pins version so installs auto-update", "marketplace resolve")