## Entity Relationship: Database Schema (Level 3 Focus)

### Recommended Type: ER Diagram with Cardinality and Attributes

```mermaid
erDiagram
     %% PR-1 Digital Curator Core Entities - Level 3 Architecture
     
    USER ||--o{ STAKEHOLDER : "defines"
    STAKEHOLDER }|--|| STATE_DATABASE : "manages, owns"
    STATE_DATABASE ||--|{ RECORD_ENTRY : "indexes, stores"

    EXTENSION_APP ||--|{ CLIPBOARD_EVENT : "captures, intercepts"  
    DESKTOP_APP ||--o{ MENU_ITEM : "exposes in tray" 

    CLIPBOARD_EVENT ||--|| PII_ENTITY : "identified by"
    PII_ENTITY }|--|| CATEGORY_TYPE : "classified as"

    TEST_PLAN ||--|{ SCENARIO : "executes, validates"  
    SCENARIO ||--o{ ASSERTION : "assesses"

     %% Entity attribute definitions for clarity
     
    USER {
        string id PK "User identifier"
        string email "Contact address"  
        datetime last_login "Timestamp"
    } 

    STAKEHOLDER {
        int id PK "Stakeholder ID" 
        string name FK "FK to User.name"
        enum role "PM,Eng,QA,Admin"  
    }

    STATE_DATABASE {
        string db_path PK "/dolt/repo/path"
        bool in_transaction "true/false"
        array tracked_tables ["records","exclusions"]
    }

    RECORD_ENTRY {
        hash placeholder_hash PK "SHA256 hash key"  
        text original_content "-" "PII data" -
     }

```

