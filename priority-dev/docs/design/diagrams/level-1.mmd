C4Container
    title "priority.dev v2.1 (PROPOSAL, draft design, not built)"

    System_Ext(adv, "Language model (advisor)", "Generative model, interprets cases and drafts replies")
    System_Ext(jev, "System-1 classifier (Jev)", "Hosted API, typed decisions: status, human needed, risk, priority")
    System_Ext(tmux, "tmux and coding agents", "Claude Code sessions in tmux, with hooks and transcript files")
    Container(interp, "Interpreter", "cascade: System-1 classifier first, advisor second", "Reads session events, emits fact and proposal events")
    Container(adapter, "Session adapter (tmux)", "runs in the adapter host, pulls commands, opens no inbound port", "Signal source and transport")
    Container(policy, "Policy engine", "deterministic code, fixed deny list", "Decides allow, deny, or escalate and sets the priority class")
    Container(actuator, "Actuator", "Sends input, records gate approvals, opens items", "Writes an intent before and an effect after each command")
    System_Ext(tracker, "CoBuilder tracker", "Workflow state through tracker.py")
    Container(aq, "Attention queue", "Ranked items that wait for a human", "Takes the human answer and appends it as an event")
    Container(nq, "Notification queue", "Plans delivery by priority class", "Queues one notification for each target")
    System_Ext(phone, "Phone and email targets (later)", "Mobile push and email")
    Container(notifier, "Notifier plugins", "desktop, mobile push, email, inbox stream", "One plugin for each target")
    Container(desktop, "Desktop notifier (host process, v0.1)", "Runs on the host", "Shows an OS notification")
    Container(api, "Inbox API", "Request path and event stream", "The only door for a client")
    Container(client, "Inbox client", "web viewer, mobile app, command line", "Clients of the same inbox API")
    Person(dev, "Developer", "Runs up to 20 coding agents across projects")
    ContainerDb(log, "Event log", "Append-only file per project", "Every stage reads from its last cursor and appends events, the log carries the arrows")

    Rel_D(dev, client, "answers, reads")
    Rel_R(api, client, "SSE with cursor (v0.1)")
    Rel_L(client, api, "request after cursor (v0.1)")
    Rel_D(aq, api, "items")
    Rel_U(aq, nq, "attention events")
    Rel_R(nq, notifier, "notification events")
    Rel_D(notifier, api, "append notification event (v0.1)")
    Rel_R(notifier, phone, "push (later)")
    Rel_D(notifier, desktop, "OS notification (v0.1)")
    Rel_U(actuator, aq, "open item")
    Rel_R(actuator, tracker, "tracker.py")
    Rel_D(actuator, adapter, "commands (pulled)")
    Rel_L(policy, actuator, "decision events")
    Rel_R(interp, policy, "fact, proposal events")
    Rel_U(adapter, interp, "session events")
    Rel_L(tmux, adapter, "hooks, transcripts")
    Rel_D(interp, jev, "typed questions (first)")
    Rel_D(interp, adv, "forwarded cases (second)")

    UpdateRelStyle(aq, api, $offsetY="45")
    UpdateRelStyle(api, client, $offsetY="-25")
    UpdateRelStyle(client, api, $offsetY="25")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")
