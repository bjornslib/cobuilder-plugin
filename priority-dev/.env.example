# Copy to .env and fill in the key. Never commit .env.
# Provider: openrouter, nvidia_nim, or inception.
LLM_PROVIDER=inception
# Endpoint override. Empty means the provider default.
LLM_BASE_URL=https://api.inceptionlabs.ai/v1
# Model name without the provider prefix.
LLM_MODEL=mercury-3
# The active key. A per-provider key (OPENROUTER_API_KEY, NVIDIA_API_KEY,
# INCEPTION_LABS_API_KEY) is only a fallback and only for its own provider.
LLM_API_KEY=

# Reflection model for GEPA: Meta Muse Wonder (Responses API). Key: META_API_KEY.
# The code does not support the meta provider yet, so a GEPA run stops before any call.
REFLECTION_PROVIDER=meta
REFLECTION_BASE_URL=https://api.meta.ai/v1
REFLECTION_MODEL=muse-wonder-1.0
# NVIDIA Mistral reflection model (the code default). Key: NVIDIA_API_KEY.
# REFLECTION_PROVIDER=nvidia_nim
# REFLECTION_BASE_URL=https://integrate.api.nvidia.com/v1
# REFLECTION_MODEL=mistralai/mistral-large-4-1t-a52b
META_API_KEY=
