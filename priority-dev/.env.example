# Copy to .env and fill in the key. Never commit .env.
# Provider: openrouter, nvidia_nim, or inception.
LLM_PROVIDER=inception
# Endpoint override. Empty means the provider default.
LLM_BASE_URL=https://api.inceptionlabs.ai/v1
# Model name without the provider prefix.
LLM_MODEL=mercury-3
# The active key. A per-provider key (OPENROUTER_API_KEY, NVIDIA_API_KEY,
# INCEPTION_LABS_API_KEY) is only a fallback and only for its own provider.
LLM_API_KEY=
