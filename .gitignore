__pycache__/
*.pyc
.pytest_cache/
.env
.DS_Store

# cobuilder-architect view-server bookkeeping — machine-local only.
# The bundles under .cobuilder-architect/ ARE committed; that's the point of the format.
.cobuilder-architect/.view-server.pid
.cobuilder-architect/.view-server.log
.cobuilder-architect/active
# migrate_bundle.py's pre-migration story.json snapshot — disposable once a
# migration proves sound, and machine-local like the entries above.
.cobuilder-architect/*/.migration-backup/
# submit mode's pre-PR diff cache. Exactly reproducible from
# `git diff <merge-base>..<head>`, and self-referential: committing it into the
# branch it diffs rewrites it on every commit, and each version would then
# contain the last one. The authored intent/assessment beside it ARE committed.
.cobuilder-architect/*/exports/branch-*/diff.json
# extract_diffs.py's per-PR diff dumps, for the self bundle. Each one is
# reproducible at any time from `git diff <merge-base>..<head>`, and committing
# them grew the clone by ~16 MB; diffs-pr11.js alone was 6.2 MB over the
# Claude Plugin directory's 5 MiB per-file cap. The viewer asks for a diffs
# file only when data/manifest.js names that PR (shared/_manifest.py derives
# the list from the data dir), so a bundle that does not hold a file also
# stops naming it. Regenerate one on demand with extract_diffs.py.
.cobuilder-architect/self/data/diffs-pr*.js
# artifact:publish's exported single-page HTML. The published copy lives on
# claude.ai at the URL exports/publish-manifest.json records, and any export
# regenerates on demand from the bundle. exports/pr-1.html in the fixture
# bundle was 8.8 MB and exports/pr-11.html was 7.2 MB, both over the same cap.
.cobuilder-architect/*/exports/pr-*.html

.mcp.json
.serena/

# The React viewer's Node toolchain, under plugins/artifact/viewer/. ADR-0023
# accepted a Node and npm requirement for viewer changes. Neither the installed
# packages nor a scratch build belong in the repository. The source under
# plugins/artifact/viewer/src/ IS committed, and so is the packaged viewer at
# plugins/artifact/viewer/index.html until ADR-0023's output rule settles.
# The vitest cache under plugins/artifact/viewer/.vitest/ is a third such
# path. A test run writes it, holds nothing authored, and leaves it behind.
node_modules/
plugins/artifact/viewer/dist/
plugins/artifact/viewer/.vitest/

# cobuilder-implement's blind rubrics ARE committed (they're the question
# sheet); the validator evidence they're scored against is not, per
# implement/SKILL.md's "Files and state" rule.
.cobuilder/rubrics/*/evidence/
.cobuilder-architect/digital-curator-80f83abb/docs/

.venv/

# TypeScript incremental build state, from the artifact viewer.
plugins/artifact/viewer/tsconfig.tsbuildinfo

# tldraw canvases are drawn on demand and are not committed
*.tldraw
plugins/cobuilder-memory/.claude-plugin/types/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
priority-dev/fixtures/real/
