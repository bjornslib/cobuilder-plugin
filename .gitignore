# prodyssey view-server bookkeeping — machine-local only.
# The bundles under .prodyssey/ ARE committed; that's the point of the format.
.prodyssey/.view-server.pid
.prodyssey/.view-server.log
.prodyssey/active
# migrate_bundle.py's pre-migration story.json snapshot — disposable once a
# migration proves sound, and machine-local like the entries above.
.prodyssey/*/.migration-backup/

