__pycache__/
*.pyc
.pytest_cache/
.env
.DS_Store

# cobuilder-architect view-server bookkeeping — machine-local only.
# The bundles under .cobuilder-architect/ ARE committed; that's the point of the format.
.cobuilder-architect/.view-server.pid
.cobuilder-architect/.view-server.log
.cobuilder-architect/active
# migrate_bundle.py's pre-migration story.json snapshot — disposable once a
# migration proves sound, and machine-local like the entries above.
.cobuilder-architect/*/.migration-backup/
# submit mode's pre-PR diff cache. Exactly reproducible from
# `git diff <merge-base>..<head>`, and self-referential: committing it into the
# branch it diffs rewrites it on every commit, and each version would then
# contain the last one. The authored intent/assessment beside it ARE committed.
.cobuilder-architect/*/exports/branch-*/diff.json

.mcp.json
.serena/
.cobuilder-architect/digital-curator-80f83abb/docs/
