{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/deny-git-stash.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cobuilder-full-lifecycle@cobuilder-plugin": true,
    "architect@cobuilder-plugin": true,
    "pr@cobuilder-plugin": true,
    "artifact@cobuilder-plugin": true,
    "implement@cobuilder-plugin": true
  }
}
